{
  "family": "${FAMILY}",
  "containerDefinitions": [
    {
      "name": "credo-controller",
      "image": "%REPOSITORY_URI%:CREDO_v_%BUILD_NUMBER%",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8004,
          "hostPort": 8004,
          "protocol": "tcp"
        },
        {
          "containerPort": 9004,
          "hostPort": 9004,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "command": ["--auto-accept-connections", "--config", "/config/${CONFIG_FILE}"],
      "environment": [
        {
          "name": "AFJ_REST_LOG_LEVEL",
          "value": "3"
        },
        {
          "name": "LOG_FORMAT",
          "value": "json"
        }
      ],
      "environmentFiles": [
        {
          "value": "${S3_ARN}",
          "type": "s3"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "config",
          "containerPath": "/config",
          "readOnly": false
        }
      ],
      "volumesFrom": [],
      "ulimits": [],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"require('http').get('http://127.0.0.1:8004/health', (r) => process.exit(200 === r.statusCode ? 0 : 1)).on('error', () => process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 180
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/${FAMILY}",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "executionRoleArn": "arn:aws:iam::${ACCOUNT_ID}:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "placementConstraints": [],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "volumes": [
    {
      "name": "config",
      "efsVolumeConfiguration": {
        "fileSystemId": "${EFS}",
        "rootDirectory": "/"
      }
    }
  ],
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  }
}
