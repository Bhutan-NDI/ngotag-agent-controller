{
  "family": "${FAMILY}",
  "containerDefinitions": [
    {
      "name": "credo-controller",
      "image": "%REPOSITORY_URI%:CREDO_v_%BUILD_NUMBER%",
      "cpu": 154,
      "memory": 358,
      "portMappings": [
        {
          "containerPort": 8001,
          "hostPort": 8001,
          "protocol": "tcp"
        },
        {
          "containerPort": 9001,
          "hostPort": 9001,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "command": ["--auto-accept-connections", "--config", "/config.json"],
      "environment": [
        {
          "name": "AFJ_REST_LOG_LEVEL",
          "value": "3"
        },
        {
          "name": "LOG_FORMAT",
          "value": "json"
        }
      ],
      "environmentFiles": [
        {
          "value": "${S3_ARN}",
          "type": "s3"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "config",
          "containerPath": "/config.json",
          "readOnly": true
        }
      ],
      "volumesFrom": [],
      "ulimits": [],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "node -e \"require('http').get('http://127.0.0.1:8001/health', (r) => process.exit(200 === r.statusCode ? 0 : 1)).on('error', () => process.exit(1))\""
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 180
      }
    }
  ],
  "executionRoleArn": "arn:aws:iam::${ACCOUNT_ID}:role/ecsTaskExecutionRole",
  "placementConstraints": [],
  "requiresCompatibilities": ["EC2"],
  "cpu": "154",
  "memory": "358",
  "volumes": [
    {
      "name": "config",
      "host": {
        "sourcePath": "${SourcePath}"
      }
    }
  ],
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  }
}
