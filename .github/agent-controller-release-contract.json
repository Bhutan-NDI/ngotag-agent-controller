{
  "schema_version": 1,
  "release": {
    "title": "NGOTAG Agent Controller",
    "tag_prefix": "agent-controller/v",
    "image_tag_prefix": "agent-controller-",
    "platform": "linux/arm64"
  },
  "environments": {
    "qa": {
      "allowed_branch": "develop",
      "tag_prefix": "agent-controller-qa-",
      "channel": "qa",
      "legacy_release_pattern": "^qa-credo-?[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "stage": {
      "allowed_branch": "main",
      "tag_prefix": "agent-controller-stage-",
      "channel": "rc",
      "legacy_release_pattern": "^stage-credo-[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "prod": {
      "allowed_branch": "main",
      "tag_prefix": "agent-controller-prod-",
      "channel": "stable",
      "promote_from": "stage",
      "legacy_release_pattern": "^prod-credo-[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  },
  "ci": {
    "check_name": "Validate",
    "app_slug": "github-actions"
  }
}
